{
  "entry": ["src/main.ts"],
  "project": ["tsconfig.json", "tsconfig.build.json"],
  "ignore": ["dist/**", "coverage/**", "node_modules/**"],
  "ignoreDependencies": [
    "@nestjs/common",
    "@nestjs/core",
    "@nestjs/platform-express",
    "@nestjs/throttler",
    "@nestjs/terminus",
    "@ts-rest/core",
    "@ts-rest/nest",
    "dd-trace",
    "helmet",
    "pg",
    "pino",
    "reflect-metadata",
    "rxjs",
    "zod",
    "@nestjs/testing",
    "@types/express",
    "@types/pg",
    "pino-pretty",
    "source-map-support",
    "supertest",
    "ts-loader",
    "@types/jest",
    "@types/node",
    "@types/supertest",
    "ts-jest",
    "ts-node",
    "tsconfig-paths",
    "@google/generative-ai",
    "@qdrant/js-client-rest"
  ],
  "treatConfigHintsAsErrors": false,
  "rules": {
    "binaries": "off"
  }
}
