    "dotenv": "^17.3.1",
    "helmet": "^8.1.0",
    "mammoth": "1.12.0",
    "pdf-parse": "2.4.5",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
